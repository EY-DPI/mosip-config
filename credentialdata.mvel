def convertDateFormat(value, inputformat, outputformat) {
	import io.mosip.kernel.core.util.DateUtils;
	import java.util.Date;
	Date date=DateUtils.parseToDate(value, inputformat);
    String formattedDate= DateUtils.formatDate(date, outputformat);
	return formattedDate;
};
def convertToMaskData(value) {

StringBuilder sbMaskString = new StringBuilder("");

		for (int i = 0; i < 2; i++) {
			sbMaskString.append("*");
		}
		return sbMaskString.toString() + value.substring(0 + 2);
};
def formatName(names) {
    if (names == null || names.size() == 0) return "";
    StringBuilder result = new StringBuilder("");
    for (int i = 0; i < names.size(); i++) {
        if (names.get(i) != null && names.get(i).toString().length() > 0) {
            if (result.length() > 0) result.append(" ");
            result.append(names.get(i).toString());
        }
    }
    return result.toString();
};

def formatAddress(addressLines) {
    if (addressLines == null || addressLines.size() == 0) return "";
    StringBuilder result = new StringBuilder("");
    for (int i = 0; i < addressLines.size(); i++) {
        if (addressLines.get(i) != null && addressLines.get(i).toString().length() > 0) {
            if (result.length() > 0) result.append(", ");
            result.append(addressLines.get(i).toString());
        }
    }
    return result.toString();
};

