def convertDateFormat(value, inputformat, outputformat) {
	import io.mosip.kernel.core.util.DateUtils;
	import java.util.Date;
	Date date=DateUtils.parseToDate(value, inputformat);
    String formattedDate= DateUtils.formatDate(date, outputformat);
	return formattedDate;
};
def convertToMaskData(value) {

StringBuilder sbMaskString = new StringBuilder("");

		for (int i = 0; i < 2; i++) {
			sbMaskString.append("*");
		}
		return sbMaskString.toString() + value.substring(0 + 2);
};
def formatName(names) {
    if (names == null || !(names instanceof java.util.List) || names.size() == 0) return "";
    def sb = new java.lang.StringBuilder();
    for (item : names) {
        def val = (item instanceof java.util.Map && item.containsKey("value")) ? item.get("value") : item;
        if (val != null && !val.toString().trim().isEmpty()) {
            if (sb.length() > 0) sb.append(" ");
            sb.append(val.toString().trim());
        }
    }
    return sb.toString();
};

def formatAddress(addressLines) {
    if (addressLines == null || !(addressLines instanceof java.util.List) || addressLines.size() == 0) return "";
    def sb = new java.lang.StringBuilder();
    for (item : addressLines) {
        def val = (item instanceof java.util.Map && item.containsKey("value")) ? item.get("value") : item;
        if (val != null && !val.toString().trim().isEmpty()) {
            if (sb.length() > 0) sb.append(", ");
            sb.append(val.toString().trim());
        }
    }
    return sb.toString();
};

